# 复制为 .env 后按运行环境填写；不要提交 .env 或真实密钥。
# Docker 运行机配置。复制为 .env 后，替换所有带“运行机必须修改”注释的值。
# 不要提交 .env、密码或密钥。

# 运行机必须修改：使用至少 50 个随机字符的 Django 密钥。
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret

# 运行机必须修改：填写运行机的 IP 地址或 DNS 名称；多个值以英文逗号分隔。
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 通常无需修改：Docker 首次启动时用这些值创建数据库和应用角色。
DATABASE_NAME=grindbuddy
DATABASE_USER=grindbuddy_app

# 运行机必须修改：使用独立的高强度数据库密码。
DATABASE_PASSWORD=replace-with-a-database-password

# 运行机按需修改：浏览器从此端口访问系统，默认 http://<运行机IP>:8080。
WEB_PORT=8080

# 运行机按需修改：仅当浏览器会直接跨域访问 API 时添加其完整来源。
CORS_ALLOWED_ORIGINS=http://localhost:8080

# 密码重置邮件中使用的前端链接；必须包含 {uid} 和 {token} 占位符。
PASSWORD_RESET_URL=http://localhost:8080/reset-password?uid={uid}&token={token}
DEFAULT_FROM_EMAIL=noreply@example.com
# 生产环境设置为 SMTP 后端并提供相应的 Django SMTP 环境变量；本地默认输出到后端日志。
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-an-smtp-username
EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
EMAIL_USE_TLS=true